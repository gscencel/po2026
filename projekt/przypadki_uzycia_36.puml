@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Mieszkaniec" as Mieszkaniec
actor "Dyspozytor" as Dyspozytor
actor "Pracownik Ekipy" as Ekipa

rectangle "System Obsługi Zgłoszeń Awarii Miejskiej Infrastruktury" {
  
  ' Przypadki dla Mieszkańca
  package "Panel użytkownika" {
    usecase "Zaloguj się" as UC_Login
    usecase "Zgłoszenie awarii" as UC_Zgloszenie
    usecase "Śledzenie statusu zgłoszenia" as UC_Status
  }

  ' Przypadki dla Dyspozytora (Obsługa + Administracja)
  package "Panel dyspozytora" {
    package "Zarządzanie zgłoszeniami" {
      usecase "Weryfikacja zgłoszenia" as UC_Weryfikacja
      usecase "Odrzucenie zgłoszenia" as UC_Odrzucenie
      usecase "Zmiana priorytetu awarii" as UC_Priorytet
      usecase "Przydzielenie zadania do ekipy" as UC_Przydzial
    }
    package "Zarządzanie użytkownikami" {
      usecase "Zarządzanie kontami użytkowników" as UC_Konta
    }
  }

  ' Przypadki dla Ekipy Technicznej
  package "Panel ekipy technicznej" {
    usecase "Podgląd przypisanych zadań" as UC_Zadania
    usecase "Zmiana statusu realizacji" as UC_ZmianaStatusu
    usecase "Dodanie dokumentacji po naprawie" as UC_Dokumentacja
  }
}

' Relacje Mieszkańca
Mieszkaniec --> UC_Login
Mieszkaniec --> UC_Zgloszenie
Mieszkaniec --> UC_Status

' Wymóg logowania dla operacji Mieszkańca
UC_Zgloszenie .> UC_Login : <<include>>
UC_Status .> UC_Login : <<include>>

' Relacje Dyspozytora
Dyspozytor --> UC_Weryfikacja
Dyspozytor --> UC_Odrzucenie
Dyspozytor --> UC_Priorytet
Dyspozytor --> UC_Przydzial
Dyspozytor --> UC_Konta

' Relacje Ekipy
Ekipa --> UC_Zadania
Ekipa --> UC_ZmianaStatusu
UC_ZmianaStatusu .> UC_Dokumentacja : <<include>>

@enduml
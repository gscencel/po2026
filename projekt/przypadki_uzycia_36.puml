@startuml
'https://plantuml.com/sequence-diagram
left to right direction

package "System obsługi awarii miejskiej infrastruktury"{
	package "Panel użytkownika"{
		usecase "Zaloguj się" as UC_login
		usecase "Zgłoś awarię" as UC_report
		usecase "Sprawdź staus awarii" as UC_check
	}
	package "Zarządzanie użytkownikami"{
		usecase "Usuń użytkownika" as UC_deluser
		usecase "Dodaj użytkownika" as UC_adduser
		usecase "Zobacz dane użytkownika" as UC_showuser

	}	
	package "Zarządzanie zgłoszeniami"{
		usecase "Zobacz zgłoszenia" as UC_look
	}
}


@enduml